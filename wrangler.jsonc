{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "piping-tag-extractor-worker",
  "main": "src/main.py",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "python_workers"
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-3.8-flash",
    "GEMINI_FALLBACK_MODEL": "gemini-3.7-flash",
    "MAX_TILES": "8"
  }
}
